# ─── Database ────────────────────────────────────────────────────────────────
# Local cluster created by `npm run db:local -- init` (no password, localhost only).
# Railway staging: use the PostgreSQL service DATABASE_URL reference, not this URL.
DATABASE_URL="postgresql://jpf@localhost:54329/jpf_dev"
# Used by integration tests (`npm test`). Tests that need it are skipped when unset.
TEST_DATABASE_URL="postgresql://jpf@localhost:54329/jpf_test"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
# Staging requires the exact HTTPS public origin, without /api/auth or any path.
# NODE_ENV=production is set by the host; PORT is injected by Railway and read by next start.
# Admin roles are assigned by an operator in the database after identity verification.
# An email address supplied at sign-up never grants admin access.

# ─── AI (optional; mocks are used when unset) ────────────────────────────────
# LLM_PROVIDER: anthropic | mock
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
# Tutor model (default claude-opus-5-5). A smaller model (e.g. claude-haiku-4-5) costs less.
LLM_MODEL=""
# Per-learner daily limits for the tutor
TUTOR_DAILY_TURNS="80"
TUTOR_DAILY_REPORTS="10"
WRITING_DAILY_ASSESSMENTS="10"

# ─── Speech (optional; browser/mocks are used when unset) ────────────────────
# SPEECH_PROVIDER: azure | mock
SPEECH_PROVIDER="mock"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
