# ─── Database ────────────────────────────────────────────────────────────────
# Local cluster created by `npm run db:local -- init` (no password, localhost only).
DATABASE_URL="postgresql://jpf@localhost:54329/jpf_dev"
# Used by integration tests (`npm test`). Tests that need it are skipped when unset.
TEST_DATABASE_URL="postgresql://jpf@localhost:54329/jpf_test"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated e-mails that receive the admin role on sign-up.
ADMIN_EMAILS=""

# ─── AI (optional; mocks are used when unset) ────────────────────────────────
# LLM_PROVIDER: anthropic | mock
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# ─── Speech (optional; browser/mocks are used when unset) ────────────────────
# SPEECH_PROVIDER: azure | mock
SPEECH_PROVIDER="mock"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
